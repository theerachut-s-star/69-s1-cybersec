# API requests

@baseUrl = http://localhost:9092

## 1.Admin

### 1.1 Admin Login
# @name adminLogin
POST {{baseUrl}}/admin/login
content-type: application/json

{
  "email": "",
  "password": "",
  "rememberMe": false
}

### 1.2 Admin Signup
POST {{baseUrl}}/admin/auth/register-admin
content-type: application/json

{
  "firstName": "",
  "lastName": "",
  "email": "",
  "password": "",
  "confirmPassword": ""
}

### 1.3 Admin Forgot Password
POST {{baseUrl}}/admin/forgot-password
content-type: application/json

{
  "email": ""
}

### 1.3.1 Admin Reset Password
POST {{baseUrl}}/admin/reset-password
content-type: application/json

{
  "password": "",
  "resetPasswordToken": ""
}

### 1.4 Admin Profile
GET {{baseUrl}}/admin/me
Authorization: Bearer {{adminLogin.response.body.$.data.token}}

## 2.User

### 2.1 User Signup
# @name userRegister
POST {{baseUrl}}/api/auth/local/register
content-type: application/json

{
  "username": "",
  "email": "",
  "password": "",
  "confirmPassword": ""
}

### 2.2 User Login
# @name userLogin
POST {{baseUrl}}/api/auth/local
content-type: application/json

{
  "identifier": "",
  "password": ""
}

### 2.3 User Forgot Password
# @name userForgotPassword
POST {{baseUrl}}/api/auth/forgot-password
content-type: application/json

{
  "email": ""
}

### 2.3.1 User Reset Password
POST {{baseUrl}}/api/auth/reset-password
content-type: application/json

{
  "code": "",
  "password": "",
  "passwordConfirmation": ""
}

### 2.4 User Profile
# @name userProfile
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{userLogin.response.body.jwt}}

## 3.Content

### 3.1 Student

### 3.1.1 Create
# @name createStudent
POST {{baseUrl}}/api/students
Authorization: Bearer {{userLogin.response.body.jwt}}
content-type: application/json

{
  "data": {
    "name": "",
    "mobile": "",
    "cardId": ""
  }
}

### 3.1.2 List All
# @name getStudents
GET {{baseUrl}}/api/students
Authorization: Bearer {{userLogin.response.body.jwt}}

### 3.1.3 List with ID
# @name getStudentById
GET {{baseUrl}}/api/students/{{createStudent.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

### 3.1.4 Update
# @name updateStudent
PUT {{baseUrl}}/api/students/{{createStudent.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}
content-type: application/json

{
  "data": {
    "name": ""
  }
}

### 3.1.5 Delete
# @name deleteStudent
DELETE {{baseUrl}}/api/students/{{createStudent.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

### 3.2 Subject

### 3.2.1 Create
# @name createSubject
POST {{baseUrl}}/api/subjects
Authorization: Bearer {{userLogin.response.body.jwt}}
content-type: application/json

{
  "data": {
    "name": ""
  }
}

### 3.2.2 List All
# @name getSubjects
GET {{baseUrl}}/api/subjects
Authorization: Bearer {{userLogin.response.body.jwt}}

### 3.2.3 List with ID
# @name getSubjectById
GET {{baseUrl}}/api/subjects/{{createSubject.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

### 3.2.4 Update
# @name updateSubject
PUT {{baseUrl}}/api/subjects/{{createSubject.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}
content-type: application/json

{
  "data": {
    "name": ""
  }
}

### 3.2.5 Delete
# @name deleteSubject
DELETE {{baseUrl}}/api/subjects/{{createSubject.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

### 3.3 Teacher

### 3.3.1 Create
# @name createTeacher
POST {{baseUrl}}/api/teachers
Authorization: Bearer {{userLogin.response.body.jwt}}
content-type: application/json

{
  "data": {
    "name": ""
  }
}

### 3.3.2 List All
# @name getTeachers
GET {{baseUrl}}/api/teachers
Authorization: Bearer {{userLogin.response.body.jwt}}

### 3.3.3 List with ID
