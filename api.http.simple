GET {{baseUrl}}/api/teachers/{{createTeacher.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

### 3.3.4 Update
# @name updateTeacher
PUT {{baseUrl}}/api/teachers/{{createTeacher.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}
content-type: application/json

{
  "data": {
    "name": ""
  }
}

### 3.3.5 Delete
# @name deleteTeacher
DELETE {{baseUrl}}/api/teachers/{{createTeacher.response.body.$.data.id}}
